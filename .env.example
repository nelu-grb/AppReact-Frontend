# ============================================================================
# MSAL Configuration (Azure Entra ID)
# ============================================================================
# Follow this guide to get these values:
# https://learn.microsoft.com/azure/active-directory/develop/quickstart-register-app

# Frontend Application (client) ID from Azure App Registration
# Find in: Azure Portal → App registrations → Your App → Overview
VITE_AZURE_CLIENT_ID=PLACEHOLDER_CLIENT_ID

# Directory (tenant) ID from Azure App Registration
# Find in: Azure Portal → App registrations → Your App → Overview
VITE_AZURE_TENANT_ID=PLACEHOLDER_TENANT_ID

# Azure Subdomain (Entra External ID)
# Format: https://<SUBDOMAIN>.ciamlogin.com/<TENANT_ID>/v2.0/
# Example: if your authority is "https://mycompany.ciamlogin.com/...", use "mycompany"
VITE_AZURE_SUBDOMAIN=PLACEHOLDER_SUBDOMAIN

# Redirect URI - must match what's configured in Azure App Registration
# Local development example: http://localhost:5173
# Production example: https://yourdomain.com
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# API Scopes - comma-separated list of scopes to request
# These are the scopes exposed by your Backend API in Azure
# Format: api://<backend-app-id>/<scope-name>
# Examples:
#   Single scope: api://myapi/read
#   Multiple scopes: api://myapi/read,api://myapi/write
VITE_AZURE_SCOPES=PLACEHOLDER_SCOPE_1,PLACEHOLDER_SCOPE_2

# ============================================================================
# Backend API Configuration
# ============================================================================

# Backend API Base URL
# Local development: http://localhost:8080
# AWS: https://your-api-gateway-url.execute-api.region.amazonaws.com
VITE_API_BASE_URL=http://localhost:8080

# API Scope for token acquisition (usually same as one of VITE_AZURE_SCOPES)
# This is used when acquiring tokens to call the backend
# Format: api://<backend-app-id>/<scope-name>
# Example: api://myapi/read
VITE_API_SCOPE=PLACEHOLDER_API_SCOPE

# ============================================================================
# Environment
# ============================================================================
VITE_ENVIRONMENT=development

# ============================================================================
# HOW TO FILL IN THESE VALUES:
# ============================================================================
# 
# 1. VITE_AZURE_CLIENT_ID & VITE_AZURE_TENANT_ID:
#    - Go to Azure Portal → Azure Entra ID → App registrations
#    - Find your Frontend application
#    - Copy the Application (client) ID and Directory (tenant) ID
#
# 2. VITE_AZURE_SUBDOMAIN:
#    - Go to Azure Portal → Azure Entra ID → External Identities
#    - Check your User Flow settings for the issuer URL
#    - Extract the subdomain from: https://<SUBDOMAIN>.ciamlogin.com/
#
# 3. VITE_AZURE_REDIRECT_URI:
#    - Must match the Redirect URI in your Frontend App Registration
#    - For local dev: http://localhost:5173
#    - For production: your actual domain
#
# 4. VITE_AZURE_SCOPES:
#    - Go to your Backend API App Registration
#    - Check "Expose an API" section for the scopes you created
#    - Examples: api://myapi/read, api://myapi/write
#
# 5. VITE_API_BASE_URL:
#    - Where your backend is running
#    - Local: http://localhost:8080
#    - AWS: https://your-api-gateway-url.execute-api.region.amazonaws.com
#
# 6. VITE_API_SCOPE:
#    - Usually same as one of the scopes in VITE_AZURE_SCOPES
#    - Used for token acquisition when calling the backend API
# ============================================================================
